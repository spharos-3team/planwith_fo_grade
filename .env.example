# Local / IntelliJ. Docker overrides via env/grade.env on the server.
# Infra MySQL host port is 3307.

DB_URL=jdbc:mysql://127.0.0.1:3307/grade_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=grade_user
DB_PASSWORD=grade_pass
JPA_DDL_AUTO=update
EUREKA_CLIENT_ENABLED=false